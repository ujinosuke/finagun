watchlist.json
watchlist.json.tmp
watchlist.json.bak

# 比較表の保存ファイル(個人ごとの登録内容。git 管理外)
compare.json
compare.json.tmp
# 比較表の Excel 出力(既定のファイル名)
compare_*.xlsx
# テクニカルトレード訓練のレポート(既定のファイル名)
techtrainer_*.html

# 資産管理の保存ファイル(個人の取引記録。git 管理外)
asset.json
asset.json.tmp
asset.json.bak

# 楽天証券の CSV のサンプル(個人の資産内容。git 管理外)
test_asset.csv

# 配当情報のキャッシュ(yfinance から取得。git 管理外)
dividend_cache.json
dividend_cache.json.tmp

# 業績のキャッシュ(fina_compare.py が yfinance から取得。git 管理外)
financials_cache.json
financials_cache.json.tmp

# 全体設定(個人ごとの値。データフォルダの場所など。git 管理外)
settings.json
settings.json.tmp
settings.json.bak

# ToreCan.py のログとロックファイル(git 管理外)
logs/
torecan.lock
gather.lock

# 初期化したときに移した保存ファイル(git 管理外)
backup/

# チャートの表示と図形(銘柄ごと。git 管理外)
charts/
